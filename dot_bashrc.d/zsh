# Bazzite: the login shell stays bash (chsh to a Homebrew shell is unsupported
# on the atomic image), so every interactive bash (Konsole, SSH, TTY) hands over
# to Homebrew's zsh here. Non-interactive sessions (scp, rsync, `ssh host cmd`)
# stay in bash. BASH_ZSH_HANDOFF is inherited by everything started from that
# zsh, so a `bash` typed inside zsh stays bash instead of bouncing back.
if [[ $- == *i* ]] && [ -z "${BASH_ZSH_HANDOFF:-}" ] && [ -x /home/linuxbrew/.linuxbrew/bin/zsh ]; then
    export BASH_ZSH_HANDOFF=1
    if shopt -q login_shell; then
        exec /home/linuxbrew/.linuxbrew/bin/zsh -l
    fi
    exec /home/linuxbrew/.linuxbrew/bin/zsh
fi
