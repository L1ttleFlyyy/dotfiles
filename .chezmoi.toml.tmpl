# vim: ft=toml
# chezmoi:template:left-delimiter=#{ right-delimiter=}#
#{- $isWorkMac := and (eq .chezmoi.os "darwin") (eq .chezmoi.username "cxcx")}#
#{- $isWorkLinux := and (eq .chezmoi.os "linux") (eq (dig "id" "none" .chezmoi.osRelease) "rhel")}#
#{- $isWork := or $isWorkMac $isWorkLinux }#
[edit]
    apply = false
[diff]
    command = "nvim"
    args = ["-d", "{{ .Target }}", "{{ .Destination }}"]
#{- if eq .chezmoi.os "windows" }#
[cd]
    command = "pwsh"
    args = ["-NoLogo"]
[interpreters.ps1]
    command = "pwsh"
    args = ["-NoLogo", "-NoProfile"]
#{- end }#


[data]
    # Machine class. Evaluated at `chezmoi init` time, not per-apply, so re-run
    # init if the config predates these keys or they will be undefined. See
    # README.md for which gate to reach for.
    isWork = #{ $isWork }#
    isWorkMac = #{ $isWorkMac }#
    isWorkLinux = #{ $isWorkLinux }#
#{- if $isWork }#
    claudeCodeWrapper = "#{ promptStringOnce . "claudeCodeWrapper" "Claude Code wrapper path" }#"
#{- if $isWorkMac }#
    corpHost = "#{ promptStringOnce . "corpHost" "Corp host for VPN connectivity check (blank to skip)" }#"
#{- end }#
#{- end }#
