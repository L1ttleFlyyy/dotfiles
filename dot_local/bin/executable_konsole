#!/bin/sh
# Konsole with the profile matching the desktop's light/dark setting (XDG
# portal color-scheme: 1 dark, 2 light, 0 no preference -> dark), picked per
# new window; Konsole cannot follow the theme itself (KDE bug 507406).
# Shadows /usr/bin/konsole through PATH (~/.local/bin comes first in the
# desktop session), so menus, Ctrl+Alt+T and Dolphin/KIO's "open terminal"
# (which appends --workdir to commands starting with "konsole") all get it.
scheme="$(busctl --user call org.freedesktop.portal.Desktop /org/freedesktop/portal/desktop \
    org.freedesktop.portal.Settings ReadOne ss org.freedesktop.appearance color-scheme 2>/dev/null \
    | awk '{print $3}')"
if [ "$scheme" = 2 ]; then profile=Light.profile; else profile=Default.profile; fi
kwriteconfig6 --file konsolerc --group "Desktop Entry" --key DefaultProfile "$profile"
exec /usr/bin/konsole "$@"
