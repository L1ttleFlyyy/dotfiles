# Font
font-family = FiraCode Nerd Font
font-size = 16

# Cursor
cursor-style-blink = true
# disable shell-integration cursor override (bar is hard to see)
shell-integration-features = no-cursor,sudo,title,ssh-env,no-ssh-terminfo,path

# Theme (Catppuccin dark / Gruvbox light — auto light/dark)
theme = light:Gruvbox Material Light,dark:Catppuccin Macchiato

# macOS: tab bar integrates with titlebar, theme follows terminal background
macos-titlebar-style = transparent
window-theme = auto

# macOS: left Option as Alt/Meta for word-movement keybinds
macos-option-as-alt = left

# Cmd key line-editing bindings
keybind = cmd+left=text:\x01
keybind = cmd+right=text:\x05
keybind = cmd+backspace=text:\x15

# Forward-delete bindings (fn+delete = forward delete key on macOS)
keybind = alt+delete=text:\x1bd
keybind = cmd+delete=text:\x0b

# Recover a terminal left in a broken state (e.g. an abrupt SSH drop leaves the
# remote tmux/nvim mouse tracking enabled, so the terminal spews control codes
# on mouse input). The remote can't undo it once the link is dead; this resets
# locally and works even while ssh is still hung. `reset` is a one-shot RIS that
# also re-allows apps to re-enable mouse, unlike toggle_mouse_reporting.
keybind = cmd+shift+r=reset

# disable close confirmation on Cmd+W
confirm-close-surface = false

# enable notifications
desktop-notifications = true
