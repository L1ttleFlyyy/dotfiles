# vim: ft=gitconfig
[core]
	editor = nvim
{{- if eq .chezmoi.os "windows" }}
	autocrlf = input
{{- else }}
	autocrlf = false
{{- end }}
[init]
	defaultBranch = main
[push]
	default = simple
[pull]
	rebase = true
[fetch]
	prune = true
[diff]
	tool = nvimdiff
[difftool]
	prompt = false
[merge]
	tool = nvimdiff
[mergetool]
	prompt = false
	keepBackup = false
[alias]
	d = difftool
	stsh = stash
	stat = status
{{- if not .isWork }}
[user]
	name = l1ttleflyyy
	email = l1ttleflyyy@users.noreply.github.com
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
{{- end }}
{{- if eq .chezmoi.os "windows" }}
[credential "helperselector"]
	selected = manager
{{- end }}
