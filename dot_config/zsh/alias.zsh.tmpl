# vim: ft=zsh
# `clear` scrolls the current screen up into the scrollback instead of wiping
# it (RIS/\033c erases scrollback). Print a screenful of blank lines to push the
# old content above the fold, then home the cursor so the next prompt starts on
# the first line. Use `reset` when you actually want a full RIS/scrollback wipe.
unalias clear 2>/dev/null  # some distros ship a default `clear` alias that
                           # would make the function definition below a parse error
clear() { repeat "${LINES:-$(tput lines)}" print ""; printf '\033[H'; }
alias c='clear'
alias df='df --human-readable'
alias du='dust --limit-filesystem'
alias fcp_deref='rsync --archive --human-readable --partial --progress --copy-links --keep-dirlinks --no-inc-recursive'
alias fcp='rsync -aHAX --human-readable --info=progress2'

# better ls
alias l="eza --icons=auto"
alias ll='l -l'
alias la='l -a'
alias lt='l -l -s modified'
alias tree="eza --tree --icons=auto"
alias tre="tree -L 2"

alias v='nvim'
alias vim='nvim'
alias vimdiff='nvim -d'
alias sys='systemctl'
alias che=chezmoi
alias cz=chezmoi
alias czcd="cd $(chezmoi source-path)"

{{- if eq .chezmoi.os "darwin" }}
# Tailscale cli
[[ -x "/Applications/Tailscale.app/Contents/MacOS/Tailscale" ]] \
    && alias tailscale="/Applications/Tailscale.app/Contents/MacOS/Tailscale"
{{- end }}

# install ghostty terminfo on remote/local targets
copy-ghostty-terminfo-ssh() { infocmp -x xterm-ghostty | ssh "$@" -- 'tic -x -o "$HOME/.terminfo"' - }
copy-ghostty-terminfo-su() {
    local tmp=/tmp/ghostty-terminfo.$$ && infocmp -x xterm-ghostty > "$tmp" &&
    chmod 644 "$tmp" && su - "$1" -c "tic -x -o ~/.terminfo $tmp"; rm -f "$tmp"
}

# crc: launch claude remote-control for $PWD, name defaults to dir basename.
#   crc [name] [extra claude flags...]
crc() { claude remote-control --name "${1:-${PWD:t}}" "${@:2}" }

# additional user aliases
[[ -r "${ZDOTDIR}/alias.local" ]] && source "${ZDOTDIR}/alias.local"
