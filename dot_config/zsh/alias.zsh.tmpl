# When an SSH connection dies abruptly (network change, sleep, `~.`), the
# remote tmux/nvim never gets to disable mouse tracking, so afterwards the local
# terminal spews control codes on mouse input. The remote can't fix this once
# the link is dead; the tmux maintainer's recommended recovery is to run `reset`
# locally (tmux#2616). ssh exits 255 *only* on its own errors / abnormal drops
# and passes the remote shell's code through otherwise, so reset just in that
# case -- clean logouts keep their scrollback (reset/RIS would clear it).
# To recover manually any time, run `reset` (full RIS) locally.
ssh() {
    command ssh "$@"
    local ret=$?
    [[ $ret -eq 255 ]] && command reset
    return $ret
}

# install ghostty terminfo on remote/local targets
copy-ghostty-terminfo-ssh() { infocmp -x xterm-ghostty | ssh "$@" -- 'tic -x -o "$HOME/.terminfo"' - }
copy-ghostty-terminfo-su() {
    local tmp=/tmp/ghostty-terminfo.$$ && infocmp -x xterm-ghostty > "$tmp" &&
    chmod 644 "$tmp" && su - "$1" -c "tic -x -o ~/.terminfo $tmp"; rm -f "$tmp"
}

# crc: launch claude remote-control for $PWD, name defaults to dir basename.
#   crc [name] [extra claude flags...]
crc() { claude remote-control --name "${1:-${PWD:t}}" "${@:2}" }

# additional user aliases
[[ -r "${ZDOTDIR}/alias.local" ]] && source "${ZDOTDIR}/alias.local"
