[Unit]
Description=Codex remote-control managed app-server
Documentation=https://github.com/openai/codex/blob/main/codex-rs/app-server-daemon/README.md
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=CODEX_HOME=%h/.codex
ExecStart=%h/.config/systemd/user/codex-remote-control-start
ExecReload=%h/.config/systemd/user/codex-remote-control-start
ExecStop=%h/.codex/packages/standalone/current/codex remote-control stop --json
Restart=on-failure
RestartSec=60
TimeoutStartSec=180
TimeoutStopSec=90

[Install]
WantedBy=default.target
