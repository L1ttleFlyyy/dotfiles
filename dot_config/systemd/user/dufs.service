[Unit]
Description=Dufs File Server - Home Directory
# Keep retrying until tailscaled is ready.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/bin/bash -c 'bind_ip=$$(/usr/bin/tailscale ip -4) && exec /home/linuxbrew/.linuxbrew/bin/dufs "%h" --bind "$$bind_ip" --port 5000 --allow-all --hidden ".*"'
Restart=always
RestartSec=60

[Install]
WantedBy=default.target
