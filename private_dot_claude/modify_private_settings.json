{{- /* chezmoi:modify-template */ -}}
{{- $data := dict -}}
{{- with .chezmoi.stdin -}}
{{-   $data = . | fromJson -}}
{{- end -}}

{{- /* Keep machine-local Notification hooks; only ensure ours is present. */ -}}
{{- $notifyCmd := "~/.config/claude/tmux-notify.sh" -}}
{{- $notify := list (dict "hooks" (list (dict "type" "command" "command" $notifyCmd))) -}}
{{- range (dig "hooks" "Notification" (list) $data) -}}
{{-   $isOurs := false -}}
{{-   range (dig "hooks" (list) .) -}}
{{-     if contains ".config/claude/tmux-notify.sh" (dig "command" "" .) -}}
{{-       $isOurs = true -}}
{{-     end -}}
{{-   end -}}
{{-   if not $isOurs -}}
{{-     $notify = append $notify . -}}
{{-   end -}}
{{- end -}}

{{- /* Codex CLI plugin: personal machines only — it ships code to OpenAI. */ -}}
{{- if not .isWork -}}
{{-   $data = $data
        | setValueAtPath "enabledPlugins.codex@openai-codex" true
        | setValueAtPath "extraKnownMarketplaces.openai-codex.source.source" "github"
        | setValueAtPath "extraKnownMarketplaces.openai-codex.source.repo" "openai/codex-plugin-cc" -}}
{{- end }}

{{ $data
  | setValueAtPath "env.ENABLE_CLAUDEAI_MCP_SERVERS" "false"
  | setValueAtPath "autoMemoryEnabled" false
  | setValueAtPath "enableWorkflows" false
  | setValueAtPath "workflowKeywordTriggerEnabled" false
  | setValueAtPath "awaySummaryEnabled" false
  | setValueAtPath "skipDangerousModePermissionPrompt" true
  | setValueAtPath "remoteControlAtStartup" true
  | setValueAtPath "permissions.defaultMode" "auto"
  | setValueAtPath "tui" "fullscreen"
  | setValueAtPath "attribution.commit" ""
  | setValueAtPath "attribution.pr" ""
  | setValueAtPath "statusLine.type" "command"
  | setValueAtPath "statusLine.command" "bash ~/.config/claude/claude-statusline.sh"
  | setValueAtPath "hooks.Notification" $notify
  | toPrettyJson }}
