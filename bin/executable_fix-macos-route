#!/bin/bash

# Fix Tailscale routing on macOS when Work VPN conflicts with 100.64/10
# Replaces the broad /10 route with a /24 subnet route + MagicDNS host route

set -e

TAILSCALE_SUBNET="100.123.123"
AUTO_CONFIRM=false

if [[ "$1" == "--yes" || "$1" == "-y" ]]; then
    AUTO_CONFIRM=true
fi

echo "=== Fixing Tailscale routing conflicts ==="
echo ""

# Detect Tailscale interface by matching subnet on utun interfaces
echo "Step 1: Detecting Tailscale interface"
TAILSCALE_INTERFACE=""

for iface in $(ifconfig -l | tr ' ' '\n' | grep "^utun"); do
    if ifconfig "$iface" 2>/dev/null | grep -q "inet ${TAILSCALE_SUBNET}\."; then
        TAILSCALE_INTERFACE="$iface"
        break
    fi
done

if [ -z "$TAILSCALE_INTERFACE" ]; then
    echo "✗ Error: No utun interface found with subnet ${TAILSCALE_SUBNET}.0/24"
    echo "Is Tailscale running?"
    exit 1
fi

echo "✓ Detected Tailscale interface: $TAILSCALE_INTERFACE"
echo ""

# Show commands
echo "=== Commands to be executed ==="
echo "1. sudo route delete -net 100.64.0.0/10 -ifscope $TAILSCALE_INTERFACE (scoped route)"
echo "   + global 100.64/10 only if it currently points at $TAILSCALE_INTERFACE"
echo "2. sudo route add -net ${TAILSCALE_SUBNET}.0/24 -interface $TAILSCALE_INTERFACE"
echo ""

if [ "$AUTO_CONFIRM" = false ]; then
    read -p "Proceed? [N/y]: " confirm
    if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
        echo "Cancelled"
        exit 0
    fi
    echo ""
fi

# Tailscale installs the /10 as either a plain route (UCS) or scoped route (UCSI).
# IMPORTANT: on macOS `route delete -interface X` does NOT restrict deletion to X;
# it deletes whichever 100.64/10 route is in the global table (which may belong to a
# Work VPN on a different utun). Only -ifscope is interface-safe.
echo "Step 2: Removing conflicting /10 route on $TAILSCALE_INTERFACE"

# 1. Delete the interface-scoped route (UCSI) — safe, only touches this interface.
sudo route delete -net 100.64.0.0/10 -ifscope "$TAILSCALE_INTERFACE" 2>&1 || true

# 2. The global (unscoped) 100.64/10 route is shared territory. Delete it ONLY if it
#    currently points at our Tailscale interface, otherwise we'd nuke the Work VPN's route.
global_iface=$(netstat -rn -f inet | awk '$1=="100.64/10" && $3 !~ /I/ {print $4; exit}')
if [ "$global_iface" = "$TAILSCALE_INTERFACE" ]; then
    echo "  Global 100.64/10 belongs to $TAILSCALE_INTERFACE, removing it too"
    sudo route delete -net 100.64.0.0/10 2>&1 || true
elif [ -n "$global_iface" ]; then
    echo "  Keeping global 100.64/10 (owned by $global_iface, not Tailscale)"
fi

if netstat -rn | grep -F "$TAILSCALE_INTERFACE" | grep -q "^100\.64/10"; then
    echo "✗ Failed to remove 100.64/10 route on $TAILSCALE_INTERFACE"
    exit 1
fi
echo "✓ Removed 100.64/10 route on $TAILSCALE_INTERFACE"

echo ""
echo "Step 3: Adding subnet and MagicDNS routes"

if sudo route add -net "${TAILSCALE_SUBNET}.0/24" -interface "$TAILSCALE_INTERFACE" 2>/dev/null; then
    echo "✓ Added route: ${TAILSCALE_SUBNET}.0/24 -> $TAILSCALE_INTERFACE"
else
    echo "⚠ Route already exists: ${TAILSCALE_SUBNET}.0/24"
fi


# Verification
echo ""
echo "=== Verification ==="
echo "Current routes on $TAILSCALE_INTERFACE:"
netstat -rn | grep -F "$TAILSCALE_INTERFACE"
echo ""

echo "Testing connectivity to arm-oci (100.123.123.8):"
if ping -c 1 -W 2 100.123.123.8 &>/dev/null; then
    echo "✓ Ping successful"
else
    echo "✗ Ping failed (may need to wait for Tailscale to reconnect)"
fi
