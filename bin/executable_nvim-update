#!/bin/sh
# Install or update Neovim from GitHub releases to ~/.local/
# Usage: nvim-update [stable|nightly|v0.10.4]
set -eu

CHANNEL="${1:-stable}"
PREFIX="$HOME/.local"

# Guard: if nvim is managed by homebrew, bail out
if command -v nvim >/dev/null 2>&1; then
    NVIM_PATH="$(command -v nvim)"
    case "$NVIM_PATH" in
        /opt/homebrew/*|/home/linuxbrew/*|/usr/local/Cellar/*)
            echo "nvim is installed via Homebrew at: $NVIM_PATH" >&2
            echo "Run 'brew upgrade neovim' instead." >&2
            exit 1 ;;
    esac
fi

case "$(uname -m)" in
    x86_64)          ARCH="x86_64" ;;
    aarch64|arm64)   ARCH="arm64" ;;
    *) echo "Unsupported architecture: $(uname -m)" >&2; exit 1 ;;
esac

case "$(uname -s)" in
    Linux)  OS="linux" ;;
    Darwin) OS="macos" ;;
    *) echo "Unsupported OS: $(uname -s)" >&2; exit 1 ;;
esac

if [ "$OS" = "linux" ]; then
    ARTIFACT="nvim-linux-${ARCH}.appimage"
else
    ARTIFACT="nvim-${OS}-${ARCH}.tar.gz"
fi

# On Linux, detect glibc version. If < 2.29, use neovim-releases repo
# which provides builds linked against glibc 2.17 (x86_64 only).
REPO="neovim/neovim"
if [ "$OS" = "linux" ]; then
    GLIBC_VER="$(ldd --version 2>&1 | head -1 | grep -oE '[0-9]+\.[0-9]+$')"
    GLIBC_MINOR="${GLIBC_VER#*.}"
    if [ "$GLIBC_MINOR" -lt 29 ] 2>/dev/null; then
        if [ "$ARCH" != "x86_64" ]; then
            echo "ERROR: Legacy glibc ($GLIBC_VER) + non-x86_64 ($ARCH) is unsupported." >&2
            echo "  neovim-releases only provides x86_64 builds." >&2
            exit 1
        fi
        REPO="neovim/neovim-releases"
        echo "Note: glibc $GLIBC_VER detected, using legacy builds from $REPO"
    fi
fi

case "$CHANNEL" in
    stable)
        URL="https://github.com/${REPO}/releases/latest/download/${ARTIFACT}" ;;
    nightly)
        URL="https://github.com/${REPO}/releases/download/nightly/${ARTIFACT}" ;;
    v*)
        URL="https://github.com/${REPO}/releases/download/${CHANNEL}/${ARTIFACT}" ;;
    *)
        echo "Usage: nvim-update [stable|nightly|v0.10.4]" >&2; exit 1 ;;
esac

CURRENT=""
if command -v nvim >/dev/null 2>&1; then
    CURRENT="$(nvim --version | head -1)"
fi

echo "Channel:  $CHANNEL"
echo "Current:  ${CURRENT:-not installed}"
echo "Arch:     $ARCH"
echo "Target:   $PREFIX"
echo "URL:      $URL"
echo ""

TMPDIR="${TMPDIR:-/tmp}"
TMPFILE="$TMPDIR/nvim-update-$$"
trap 'rm -rf "$TMPFILE" "$TMPDIR/squashfs-root"' EXIT

echo "Downloading..."
if command -v curl >/dev/null 2>&1; then
    curl -fL --progress-bar -o "$TMPFILE" "$URL"
elif command -v wget >/dev/null 2>&1; then
    wget -q --show-progress -O "$TMPFILE" "$URL"
else
    echo "Neither curl nor wget found" >&2
    exit 1
fi

mkdir -p "$PREFIX/bin"

if [ "$OS" = "linux" ]; then
    echo "Extracting appimage..."
    chmod +x "$TMPFILE"
    cd "$TMPDIR"
    "$TMPFILE" --appimage-extract >/dev/null 2>&1
    cd - >/dev/null

    echo "Installing to $PREFIX..."
    cp -rf "$TMPDIR/squashfs-root/usr/"* "$PREFIX/"
else
    echo "Extracting tarball to $PREFIX..."
    tar -xzf "$TMPFILE" --strip-components=1 -C "$PREFIX"
fi

NEW="$("$PREFIX/bin/nvim" --version | head -1)"
echo ""
echo "Done: $NEW"

if ! echo "$PATH" | tr ':' '\n' | grep -qx "$PREFIX/bin"; then
    echo "Note: $PREFIX/bin is not in your PATH"
fi
