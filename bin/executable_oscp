#!/usr/bin/env sh

if [ -n "$DISPLAY" ] && command -v xclip >/dev/null 2>&1; then
    xclip -selection clipboard
else
    encoded=$(base64 | tr -d '\n')
    if [ ${#encoded} -gt 100000 ]; then
        echo "oscp: too large (${#encoded} bytes encoded, max 100000)" >&2
        exit 1
    fi
    printf "\033]52;c;%s\a" "$encoded"
fi
