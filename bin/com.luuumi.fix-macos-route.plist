<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.luuumi.fix-macos-route</string>

    <!-- Runs as root (LaunchDaemon default) so `route add/delete` needs no password. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/sbin/fix-macos-route</string>
        <string>--auto</string>
    </array>

    <!-- Pure polling. We tried the event-driven LaunchEvents +
         com.apple.system.config.network_change hook, but that notification is
         not reliably delivered to a LaunchDaemon (Wi-Fi up/down, network switch,
         and Tailscale connect/disconnect did not wake the job), so it has been
         removed. The script is a silent no-op when healthy, so polling is cheap.

         5s bounds how long routing can stay broken after Tailscale re-grabs the
         100.64/10 route. ThrottleInterval must also be 5: launchd's default
         minimum spacing between launches is 10s, which would otherwise cap the
         effective poll interval at 10s regardless of StartInterval. -->
    <key>StartInterval</key>
    <integer>5</integer>
    <key>ThrottleInterval</key>
    <integer>5</integer>

    <!-- Fix immediately on load / boot. -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/var/log/fix-macos-route.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/fix-macos-route.log</string>
</dict>
</plist>
