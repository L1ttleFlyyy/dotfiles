{
  "permissions": {
    "allow": [
      "WebSearch",
      "Bash(curl:*)",
      "Bash(ls:*)",
      "Bash(stat:*)",
      "Bash(pwd:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(wc:*)",
      "Bash(tail:*)",
      "Bash(head:*)",
      "Bash(sleep:*)",
      "Bash(mkdir:*)",
      "Bash(git:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(find:*)",
      "Bash(xargs:*)",
      "Bash(gh search:*)",
      "Bash(gh api:*)",
      "Bash(ujust:*)",
      "Bash(sudo journalctl:*)",
      "Bash(sudo dmesg:*)"
    ],
    "deny": [],
    "ask": [],
    "defaultMode": "default"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.config/claude/claude-statusline.sh"
  },
  "alwaysThinkingEnabled": true
}
