{
  "permissions": {
    "allow": [
      "WebFetch",
      "Bash(git:*)",
      "Bash(ls:*)",
      "Bash(ujust:*)",
      "Bash(sudo journalctl:*)",
      "Bash(sudo dmesg:*)"
    ],
    "deny": [],
    "ask": [],
    "defaultMode": "default"
  },
  "alwaysThinkingEnabled": true,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.config/claude/claude-statusline.sh"
  }
}
