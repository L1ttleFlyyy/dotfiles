-- ===========================================
-- colorscheme: statefile for instant startup, OSC 11 for live sync
-- ===========================================
local function set_theme(bg)
    if bg == "light" then
        vim.o.background = "light"
        vim.cmd("colorscheme gruvbox")
    else
        vim.o.background = "dark"
        vim.cmd("colorscheme catppuccin-macchiato")
    end
end

-- Instant startup: read statefile, fall back to dark
local _sf = vim.fn.expand("~/.config/colortheme/theme")
vim.fn.mkdir(vim.fn.fnamemodify(_sf, ":h"), "p")
local _ok, _lines = pcall(vim.fn.readfile, _sf)
set_theme((_ok and _lines[1]) or "dark")

-- Parse OSC 11 response from terminal and apply
vim.api.nvim_create_autocmd("TermResponse", {
    callback = function(args)
        local r, g, b = args.data.sequence:match("\027%]11;rgb:(%x+)/(%x+)/(%x+)")
        if not r then return end
        local lum = 0.299 * (tonumber(r, 16) / 65535)
                  + 0.587 * (tonumber(g, 16) / 65535)
                  + 0.114 * (tonumber(b, 16) / 65535)
        local bg = lum >= 0.5 and "light" or "dark"
        vim.schedule(function()
            set_theme(bg)
--{- if eq (dig "id" "none" .chezmoi.osRelease) "rhel" }--
            if os.getenv("SSH_CLIENT") then
                vim.fn.writefile({bg}, vim.fn.expand("~/.config/colortheme/theme"))
            end
--{- else }--
            vim.fn.writefile({bg}, vim.fn.expand("~/.config/colortheme/theme"))
--{- end }--
        end)
    end,
})

-- Query terminal background on startup and focus
local function query_bg() io.stdout:write("\27]11;?\27\\") end
vim.api.nvim_create_autocmd({ "FocusGained", "VimResume" }, { callback = query_bg })
