            event = { "BufReadPre", "BufNewFile" },
            config = function()
                local diff = require("mini.diff")
--{- if eq (dig "id" "none" .chezmoi.osRelease) "rhel" }--
                -- Perforce diff source: compare buffer against depot version
                local function gen_source_p4()
                local function set_ref(buf_id, on_fail)
                    local path = vim.api.nvim_buf_get_name(buf_id)
                    if path == "" then
                        if on_fail then on_fail() end
                        return
                    end
                    vim.system(
                        { "p4", "print", "-q", path .. "#have" },
                        { text = true },
                        function(out)
                            vim.schedule(function()
                                if not vim.api.nvim_buf_is_valid(buf_id) then return end
                                if out.code == 0 then
                                    diff.set_ref_text(buf_id, out.stdout)
                                elseif on_fail then
                                    on_fail()
                                end
                            end)
                        end
                    )
                end
                return {
                    name = "p4",
                    attach = function(buf_id)
                        set_ref(buf_id, function() diff.fail_attach(buf_id) end)
                    end,
                    detach = function(buf_id)
                        vim.api.nvim_clear_autocmds({ event = "BufWritePost", buffer = buf_id })
                    end,
                    }
                end
--{- end }--
                diff.setup({
                    source = {
                        diff.gen_source.git(),
--{- if eq (dig "id" "none" .chezmoi.osRelease) "rhel" }--
                        gen_source_p4(),
--{- end }--
                        diff.gen_source.save(),
                    },
                    view = {
                        style = "sign",
                        signs = { add = "▎", change = "▎", delete = "▁" },
                    },
                })

                vim.keymap.set("n", "]h", function()
                    if vim.wo.diff then
                        vim.cmd.normal({ "]c", bang = true })
                    else
                        diff.goto_hunk("next")
                    end
                end, { desc = "Next hunk" })
                vim.keymap.set("n", "[h", function()
                    if vim.wo.diff then
                        vim.cmd.normal({ "[c", bang = true })
                    else
                        diff.goto_hunk("prev")
                    end
                end, { desc = "Prev hunk" })

                local function cursor_hunk(action)
                    local l = vim.fn.line(".")
                    diff.do_hunks(0, action, { line_start = l, line_end = l })
                end
                vim.keymap.set("n", "<leader>hs", function() cursor_hunk("apply") end, { desc = "Stage hunk (git)" })
                vim.keymap.set("n", "<leader>hr", function() cursor_hunk("reset") end, { desc = "Reset hunk" })
                vim.keymap.set("n", "<leader>hp", MiniDiff.toggle_overlay, { desc = "Preview overlay" })
            end,
        }
