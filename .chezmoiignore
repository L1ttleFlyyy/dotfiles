# .chezmoiignore
LICENSE
README.md
AGENTS.md
CLAUDE.md
.config/colortheme/README.md

{{- if ne .chezmoi.os "windows" }}
.chezmoiscripts/**
AppData/
Documents/
.winconf/
{{- else }}
.zshenv
.ignore
bin/
.local/
.config/*
!.config/git
!.config/wezterm
{{- end }}

{{- if ne .chezmoi.os "darwin" }}
Library/
{{- else}}
.config/Code/
{{- end }}

{{- if ne .chezmoi.os "linux" }}
.config/systemd/
{{- end }}

{{- if ne (dig "id" "none" .chezmoi.osRelease) "bazzite" }}
.var/app/
.config/environment.d/
{{- end }}

{{- if ne .chezmoi.username "cxcx" }}
bin/fix-macos-route
bin/install-fix-macos-route-daemon
bin/com.luuumi.fix-macos-route.plist
bin/ts-vpn-diag
{{- end }}

{{- if eq (dig "id" "none" .chezmoi.osRelease) "rhel" }}
.config/Code/
{{-   if not (env "SYNC_CLAUDE") }}
# ~/.claude is a symlink to another volume on this host. Excluding it keeps
# `chezmoi apply` from clobbering the symlink with a real directory. Reconcile
# its contents by hand with `sync-chezmoi-claude`, which sets SYNC_CLAUDE=1 to
# lift this guard so the managed targets can be rendered with `chezmoi cat`.
.claude
.claude/**
{{-   end }}
{{- end }}
